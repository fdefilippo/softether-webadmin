[Unit]
Description=SoftEther VPN web administration
Documentation=https://github.com/fdefilippo/softether-webadmin
After=network-online.target softether-vpnserver.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/softether-webadmin serve --config /etc/softether-webadmin/config.toml
Restart=on-failure

# The daemon runs as root because it must read (and, only on an explicit
# action, rewrite) /var/lib/softether/adminip.txt, which lives in a 0700 root
# directory. Everything else is locked down.
User=root
RuntimeDirectory=softether-webadmin
RuntimeDirectoryMode=0700
StateDirectory=softether-webadmin
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/softether
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
